results/tables/
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep
# Stray duplicate generated slide deck (correct copy lives in reports/)
results/FedAcuity_Midsem_Slides.pptx

# CTGAN model files (large)
data/synthetic/*.pkl

# Generated reports/slides (regenerable via src/presentation/midsem_report.py,
